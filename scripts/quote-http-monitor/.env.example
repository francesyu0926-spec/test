# 复制为 .env 后填写（勿提交真实凭证）
QUOTE_MONITOR_TOKEN=your_session_or_bearer_token
# 或使用 Cookie（二选一或同时）
# QUOTE_MONITOR_COOKIE=session=...

# 可选
# QUOTE_MONITOR_BASE_URL=https://terminal.sfccn.com/terminal/quotes
# QUOTE_MONITOR_TIMEOUT=15
# QUOTE_MONITOR_WORKERS=8
# QUOTE_MONITOR_WEBHOOK_URL=https://example.com/hook
